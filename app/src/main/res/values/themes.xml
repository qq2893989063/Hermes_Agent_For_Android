<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      NoActionBar is required for the chat screen: MainActivity installs its own
      Toolbar via setSupportActionBar(b.toolbar). With *DarkActionBar the window decor
      already supplies an action bar and AppCompat throws IllegalStateException
      ("This Activity already has an action bar supplied by the window decor").

      windowDrawsSystemBarBackgrounds/statusBarColor keep the bars dark, and the layouts
      consume window insets explicitly (MainActivity/SettingsActivity) because
      targetSdk 35 (Android 15) enforces edge-to-edge: fitsSystemWindows no longer pads
      content away from the status bar, so a Toolbar at y=0 sits UNDER a 124px cutout.
    -->
    <style name="Theme.Hermes" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/hermes_surface</item>
        <item name="colorPrimaryDark">@color/hermes_background</item>
        <item name="colorAccent">@color/hermes_gold</item>
        <item name="android:windowBackground">@color/hermes_background</item>
        <item name="android:textColorPrimary">@color/hermes_text</item>
        <item name="android:textColorSecondary">@color/hermes_muted</item>
        <item name="android:colorBackground">@color/hermes_background</item>
        <!-- Android 15 edge-to-edge: paint behind the bars, then inset the content. -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/hermes_surface</item>
        <item name="android:navigationBarColor">@color/hermes_background</item>
    </style>

    <!-- Settings screen: it uses the framework ActionBar (title + back arrow), so it
         keeps an action bar in the decor and must NOT call setSupportActionBar. -->
    <style name="Theme.Hermes.Settings" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/hermes_surface</item>
        <item name="colorPrimaryDark">@color/hermes_background</item>
        <item name="colorAccent">@color/hermes_gold</item>
        <item name="android:windowBackground">@color/hermes_background</item>
        <item name="android:textColorPrimary">@color/hermes_text</item>
        <item name="android:textColorSecondary">@color/hermes_muted</item>
        <item name="android:colorBackground">@color/hermes_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/hermes_surface</item>
        <item name="android:navigationBarColor">@color/hermes_background</item>
    </style>

    <style name="HermesRole">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/hermes_gold</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="HermesBody">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/hermes_text</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textIsSelectable">true</item>
    </style>

    <style name="HermesFieldLabel">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/hermes_muted</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
</resources>
