<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hermes_background"
    android:orientation="vertical">

    <!-- Insets are applied to this container (NOT to the Toolbar) because
         setSupportActionBar() lets AppCompat own the Toolbar's padding and it would
         overwrite anything we set there. See MainActivity.onCreate. -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/hermes_surface"
        android:elevation="4dp"
        android:title="@string/app_name"
        android:titleTextColor="@color/hermes_gold" />

    <TextView
        android:id="@+id/status_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/hermes_surface_alt"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:textColor="@color/hermes_muted"
        android:textSize="11sp"
        tools:text="未配置模型" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/message_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="12dp"
        android:scrollbars="vertical" />

    <LinearLayout
        android:id="@+id/input_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/hermes_surface"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_image"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/attach_image"
                android:textColor="@color/hermes_gold"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_file"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/attach_file"
                android:textColor="@color/hermes_gold"
                android:textSize="13sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_tools"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="工具"
                android:textColor="@color/hermes_muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_memory"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="记忆"
                android:textColor="@color/hermes_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/message_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_bubble_meta"
                android:hint="@string/message_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="5"
                android:minHeight="44dp"
                android:padding="10dp"
                android:textColor="@color/hermes_text"
                android:textColorHint="@color/hermes_muted"
                android:textSize="15sp" />

            <Button
                android:id="@+id/send_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="64dp"
                android:text="@string/send"
                android:textColor="@color/hermes_background" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
