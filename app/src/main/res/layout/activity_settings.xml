<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hermes_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/HermesFieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_base_url" />

        <EditText
            android:id="@+id/et_base_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bubble_meta"
            android:hint="@string/hint_base_url"
            android:inputType="textUri"
            android:padding="10dp"
            android:textColor="@color/hermes_text"
            android:textColorHint="@color/hermes_muted" />

        <TextView
            style="@style/HermesFieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_custom_url" />

        <EditText
            android:id="@+id/et_custom_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bubble_meta"
            android:hint="@string/hint_custom_url"
            android:inputType="textUri"
            android:padding="10dp"
            android:textColor="@color/hermes_text"
            android:textColorHint="@color/hermes_muted" />

        <TextView
            android:id="@+id/tv_custom_url_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="@string/label_custom_url_note"
            android:textColor="@color/hermes_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_effective_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:textColor="@color/hermes_ok"
            android:textSize="11sp" />

        <TextView
            style="@style/HermesFieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_api_key" />

        <EditText
            android:id="@+id/et_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bubble_meta"
            android:hint="@string/hint_api_key"
            android:inputType="textPassword"
            android:padding="10dp"
            android:textColor="@color/hermes_text"
            android:textColorHint="@color/hermes_muted" />

        <TextView
            style="@style/HermesFieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_model" />

        <EditText
            android:id="@+id/et_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bubble_meta"
            android:hint="@string/hint_model"
            android:inputType="text"
            android:padding="10dp"
            android:textColor="@color/hermes_text"
            android:textColorHint="@color/hermes_muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_fetch_models"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fetch_models"
                android:textColor="@color/hermes_gold"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_test"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/test_connection"
                android:textColor="@color/hermes_gold"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_test_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:textColor="@color/hermes_muted"
            android:textSize="12sp" />

        <TextView
            style="@style/HermesFieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_temperature" />

        <EditText
            android:id="@+id/et_temperature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bubble_meta"
            android:inputType="numberDecimal"
            android:padding="10dp"
            android:textColor="@color/hermes_text" />

        <TextView
            style="@style/HermesFieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_max_tokens" />

        <EditText
            android:id="@+id/et_max_tokens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bubble_meta"
            android:inputType="number"
            android:padding="10dp"
            android:textColor="@color/hermes_text" />

        <TextView
            style="@style/HermesFieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_system_prompt" />

        <EditText
            android:id="@+id/et_system_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bubble_meta"
            android:hint="@string/hint_system_prompt"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:padding="10dp"
            android:textColor="@color/hermes_text"
            android:textColorHint="@color/hermes_muted" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/save"
            android:textColor="@color/hermes_background" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/hermes_divider" />

        <TextView
            style="@style/HermesFieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tools_title"
            android:textColor="@color/hermes_gold" />

        <TextView
            android:id="@+id/tv_tools"
            style="@style/HermesBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/hermes_muted"
            android:textSize="13sp" />

        <TextView
            style="@style/HermesFieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/skills_title"
            android:textColor="@color/hermes_gold" />

        <TextView
            android:id="@+id/tv_skills"
            style="@style/HermesBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/hermes_muted"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/hermes_divider" />

        <TextView
            style="@style/HermesFieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_title"
            android:textColor="@color/hermes_gold" />

        <TextView
            style="@style/HermesBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_body"
            android:textColor="@color/hermes_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_prompt_size"
            style="@style/HermesBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textColor="@color/hermes_muted"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
